{
    "name": "moneo/markdown-for-agents",
    "description": "Laravel package for Cloudflare's Markdown conversion services.",
    "keywords": ["laravel", "cloudflare", "markdown", "ai", "agents", "conversion"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0",
        "league/html-to-markdown": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Moneo\\MarkdownForAgents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moneo\\MarkdownForAgents\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moneo\\MarkdownForAgents\\MarkdownForAgentsServiceProvider"
            ],
            "aliases": {
                "MarkdownForAgents": "Moneo\\MarkdownForAgents\\Facades\\MarkdownForAgents"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
